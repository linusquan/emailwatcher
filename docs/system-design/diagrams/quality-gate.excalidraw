      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Bounces / non-delivery reports and out-of-office auto-replies are pre-filtered upstream — they never reach this gate.\nNever classify from subject alone. Mixed transactional+promo → keep facts only.\nFalse-positive Notion writes are worse than misses. When unsure → UNCERTAIN / skip.",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bounces / non-delivery reports and out-of-office auto-replies are pre-filtered upstream — they never reach this gate.\nNever classify from subject alone. Mixed transactional+promo → keep facts only.\nFalse-positive Notion writes are worse than misses. When unsure → UNCERTAIN / skip.",
      "autoResize": true,
      "lineHeight": 1.25
    }
